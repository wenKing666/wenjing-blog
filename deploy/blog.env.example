# 生产环境变量。安装位置：/opt/myblog/shared/blog.env
#
# 这个文件在 releases/ 之外 —— 重新部署时整个 releases 目录会被替换，
# 但这里不会被动。密钥只存这一份。
#
# 权限建议：chmod 600，属主 myblog。
# 改完必须重启才生效：systemctl restart myblog

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------

# ⚠️ 这两个值里**都不能出现 $**。
#
# 摘要格式是 `scrypt.<盐>.<哈希>`，用点号分隔而不是美元符号 —— 这是踩过坑的：
# Next 在开发模式下加载 .env 会做一遍变量展开，`$DMmsdiNYgCOaF30dXY30YQ`
# 会被当成变量名、展开成空字符串，摘要被截断成半截。
# 症状极难排查：值非空、能通过"是否已配置"的检查，但登录永远提示密码不正确。
#
# （生产环境的环境变量由 systemd 读入、不经 Next 的 .env 加载，所以本不会踩到；
#   但保持不含 $ 是更稳妥的做法，也让你能直接用 .env 文件在本机跑生产构建。）

# 管理密码的摘要。本机运行 `npm run set-password` 生成，整行粘过来。
ADMIN_PASSWORD_HASH=

# 会话 cookie 的签名密钥，至少 32 字符。
# 生成：openssl rand -base64 48
# 换掉它 = 所有已登录的会话立即失效（这也是"强制下线"的办法）。
SESSION_SECRET=

# ---------------------------------------------------------------------------
# 按部署线路二选一
# ---------------------------------------------------------------------------

# 【A 线】域名已备案，走 Caddy + HTTPS
# SITE_URL 设成 https 开头，cookie 会自动带上 secure 属性。
# SITE_URL=https://example.com

# 【B 线】未备案 / 用 IP + 高位端口直连
# 关键：必须显式关掉 secure，否则浏览器在纯 HTTP 下不会回传 cookie，
#       表现为"密码明明输对了，却一直跳回登录页"。
# COOKIE_SECURE=false
# SITE_URL=http://1.2.3.4:8080

# ---------------------------------------------------------------------------
# 通常不需要改
# ---------------------------------------------------------------------------

# 内容目录。systemd 单元里已经设了，这里保持注释即可。
# 千万不要改成产物内部（比如 /opt/myblog/current/content）——
# 那样每次部署都会把文章连目录一起换掉。
# CONTENT_DIR=/opt/myblog/content
